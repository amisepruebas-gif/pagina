# Copia a .env.local y llena con la config del proyecto Firebase.
# Conseguir en: Firebase Console → Project settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check site key — obtener en Firebase Console → App Check → Web → reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# true = conectar a los emuladores locales (firebase emulators:start)
NEXT_PUBLIC_USE_EMULATORS=true

# ===== Server-only (NO con prefijo NEXT_PUBLIC_) =====

# ===== Stripe Checkout =====
# Obtener en https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — al crear endpoint /api/stripe/webhook en
# https://dashboard.stripe.com/test/webhooks aparece el "Signing secret".
# Para test local con `stripe listen --forward-to localhost:3030/api/stripe/webhook`
# usa el secret que imprime el CLI.
STRIPE_WEBHOOK_SECRET=whsec_...
# Moneda + país por defecto (Stripe Checkout usa esto)
STRIPE_CURRENCY=mxn
# URL base donde corre la app (usado en success_url y cancel_url)
NEXT_PUBLIC_APP_URL=http://localhost:3030

# ===== Firebase Admin SDK (server-only) =====
# Service account JSON: Firebase Console → Project settings → Service accounts →
# Generate new private key. Pega los 3 campos correspondientes aquí.
# NOTA: FIREBASE_PRIVATE_KEY debe llevar los \n literales del JSON original
# (no expandidos). El código los normaliza con .replace(/\\n/g, '\n').
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
