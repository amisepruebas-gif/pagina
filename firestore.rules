rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    // Roles: prefieren custom claim (cuando llegue setUserRole CF); mientras
    // tanto leen el doc users/{uid}.role. Usamos .get(key, default) en todo
    // para que campos faltantes no aborten la regla.

    function tokenRole() {
      return isAuth() ? request.auth.token.get('role', '') : '';
    }

    function docRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer')
        : '';
    }

    function isStaff() {
      return tokenRole() in ['staff', 'admin']
          || docRole()  in ['staff', 'admin'];
    }

    function isAdmin() {
      return tokenRole() == 'admin' || docRole() == 'admin';
    }

    // ============ CATÁLOGO PÚBLICO ============
    match /products/{id} {
      allow read:  if true;
      allow write: if isAdmin();
      match /images/{img} {
        allow read:  if true;
        allow write: if isAdmin();
      }
    }
    match /categories/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /materials/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /tags/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /discounts/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /siteContent/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /vistas/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /complaintTypes/{id} { allow read: if true; allow write: if isAdmin(); }

    // ============ USUARIO ============
    // El dueño edita su perfil PERO no su `role` ni `active` — esos campos
    // solo los cambia un admin (o el Admin SDK vía CF setUserRole). Sin esto
    // un customer podría auto-promoverse a admin escribiendo su propio doc.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isStaff();
      allow create: if isAdmin() ||
                       (isOwner(uid)
                        && request.resource.data.get('role', 'customer') == 'customer'
                        && request.resource.data.get('active', true) == true);
      allow update: if isAdmin() ||
                       (isOwner(uid)
                        && request.resource.data.get('role', 'customer')
                           == resource.data.get('role', 'customer')
                        && request.resource.data.get('active', true)
                           == resource.data.get('active', true));
      allow delete: if isAdmin();

      match /addresses/{aid}    { allow read, write: if isOwner(uid); }
      match /favorites/{pid}    { allow read, write: if isOwner(uid); }
    }

    // ============ CARRITOS ============
    // cartId = uid del cliente logueado. Invitados manejan cart en localStorage.
    match /carts/{cartId} {
      allow read, write: if isAuth() && (request.auth.uid == cartId || isStaff());
    }

    // ============ ÓRDENES ============
    // create: solo CF (cuando Stripe esté activo). update: staff puede cambiar
    // estado/paquetería. delete: nunca.
    match /orders/{id} {
      allow read:   if isStaff() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if false;
      // Staff cambia estado/paquetería, NO los montos ni el dueño de la venta.
      allow update: if isStaff()
          && request.resource.data.get('total', 0) == resource.data.get('total', 0)
          && request.resource.data.get('subtotal', 0) == resource.data.get('subtotal', 0)
          && request.resource.data.get('discountTotal', 0) == resource.data.get('discountTotal', 0)
          && request.resource.data.get('userId', '') == resource.data.get('userId', '')
          && request.resource.data.get('orderNumber', '') == resource.data.get('orderNumber', '');
      allow delete: if false;

      match /events/{eid} {
        allow read:   if isStaff() ||
                         (isAuth() && get(/databases/$(database)/documents/orders/$(id)).data.userId == request.auth.uid);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    // ============ CHAT ============
    // Mensaje válido: texto razonable, no megabytes — protege contra inflado
    // malicioso de Firestore.
    function validChatMessage() {
      return request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
    }

    match /chats/{id} {
      allow read:   if isStaff() || (isAuth() && resource.data.userId == request.auth.uid);
      // Create: el cliente solo puede abrir chats a su nombre y en estado abierto.
      // No puede pre-asignar `assignedTo` ni inflar contadores arbitrariamente.
      allow create: if isStaff() ||
                       (isAuth()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.get('status', 'open') == 'open');
      // Update: el dueño puede tocar campos suaves (preview, contadores que
      // ya manejamos atomically). NO puede cambiar `userId`, `status` ni
      // `assignedTo` — eso es prerrogativa del staff.
      allow update: if isStaff()
                    || (isAuth()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
                        && request.resource.data.get('status', 'open') == resource.data.get('status', 'open')
                        && request.resource.data.get('assignedTo', '') == resource.data.get('assignedTo', ''));
      allow delete: if false;

      match /messages/{mid} {
        allow read:   if isStaff() ||
                         (isAuth() && get(/databases/$(database)/documents/chats/$(id)).data.userId == request.auth.uid);
        allow create: if validChatMessage() && (
                         isStaff() ||
                         (isAuth() && get(/databases/$(database)/documents/chats/$(id)).data.userId == request.auth.uid)
                       );
        allow update, delete: if false;
      }
    }

    // ============ QUEJAS ============
    // create: el cliente solo puede abrir quejas A SU NOMBRE.
    match /complaints/{id} {
      allow read:   if isStaff() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ============ RESEÑAS ============
    // Lectura pública. El usuario crea/edita la suya. El ID DEBE ser
    // `{productId}_{uid}` → garantiza una sola reseña por usuario/producto.
    // rating 1-5, text acotado. El dueño NO puede cambiar `hidden` (moderación).
    function validReview() {
      return request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.get('text', '').size() <= 2000;
    }
    match /reviews/{id} {
      allow read:   if true;
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid
          && id == request.resource.data.productId + '_' + request.auth.uid
          && validReview();
      allow update: if isStaff()
          || (isAuth()
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && validReview()
              && request.resource.data.get('hidden', false)
                 == resource.data.get('hidden', false));
      allow delete: if isStaff();
    }

    // ============ COUNTERS (solo CF) ============
    match /counters/{name} {
      allow read:  if isStaff();
      allow write: if false;
    }

    // ============ DENY POR DEFECTO ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
