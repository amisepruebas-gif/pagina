{
  "name": "pagina",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @pagina/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:rules": "pnpm --filter @pagina/tests test:rules",
    "emulators": "firebase emulators:start",
    "deploy": "firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:functions": "firebase deploy --only functions",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "0.19.12",
    "firebase-tools": "^13.29.0",
    "husky": "^9.1.7",
    "next": "^16.0.0",
    "typescript": "^5.7.0",
    "which": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "^8.5.10"
    }
  }
}
